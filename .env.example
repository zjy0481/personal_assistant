# V1 环境变量模板；复制为 .env 后按需修改。真实密钥不要提交到 Git。
ASSISTANT_LOCATION=上海
ASSISTANT_TIMEZONE=Asia/Shanghai
ASSISTANT_DATA_SOURCE_WHITELIST=["weather", "news", "github", "ai"]
ASSISTANT_SOURCE_WHITELIST=["xinhua", "people", "thepaper", "chinanews", "cctv", "reuters", "ap", "bbc"]

# 推送渠道按顺序尝试：pushplus 为主渠道，wecom_group 为备用渠道。
ASSISTANT_PUSH_CHANNELS=["pushplus", "wecom_group"]

# PushPlus 微信服务号主渠道；需在 PushPlus 完成微信实名认证后获取 token。
ASSISTANT_PUSHPLUS_TOKEN=

# 企业微信群机器人备用渠道；填写完整 Webhook URL，勿提交到 Git。
ASSISTANT_WECOM_GROUP_WEBHOOK=

# 每个内容板块默认推送条数上限。
ASSISTANT_PUSH_MAX_ITEMS=5
ASSISTANT_PUSH_MOCK=false
ASSISTANT_DAILY_RETRY_MAX=3
ASSISTANT_DAILY_RETRY_INTERVAL_SECONDS=30

# 以下为企业微信自建应用遗留配置，仅供旧 WeComPushAdapter 使用；新方案不需要。
ASSISTANT_WECOM_CORPID=
ASSISTANT_WECOM_AGENTID=
ASSISTANT_WECOM_SECRET=
ASSISTANT_WECOM_USERID=
ASSISTANT_WECOM_MOCK=false

# 日报网页跳转地址；公网部署时改为实际可访问地址。
ASSISTANT_WEB_URL=http://127.0.0.1:8000/

# 公网网页鉴权 token；本机测试留空。
ASSISTANT_AUTH_TOKEN=
ASSISTANT_WEB_REQUIRE_AUTH=false
# V2 Phase 1：DeepSeek LLM 摘要与网页问答。
ASSISTANT_LLM_PROVIDER=deepseek
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_BASE_URL=https://api.deepseek.com
ASSISTANT_LLM_MODEL=deepseek-v4-flash
ASSISTANT_LLM_TIMEOUT_SECONDS=30
ASSISTANT_LLM_DAILY_LIMIT=300
ASSISTANT_LLM_MINUTE_LIMIT=10
ASSISTANT_LLM_FAILURE_THRESHOLD=3
ASSISTANT_LLM_CIRCUIT_BREAKER_SECONDS=60
ASSISTANT_LLM_SUMMARY_ENABLED=true
ASSISTANT_LLM_MAX_ITEMS=50
ASSISTANT_LLM_CHAT_HISTORY_LIMIT=50
ASSISTANT_LLM_CHAT_RETENTION_DAYS=7# V2 Phase 2：极端天气预警备用源与独立监测进程。
ASSISTANT_WEATHER_ALERT_ENABLED=true
ASSISTANT_WEATHER_ALERT_LOCATIONS=[]
ASSISTANT_WEATHER_ALERT_INTERVAL_SECONDS=600
ASSISTANT_WEATHER_ALERT_TYPES=[]
ASSISTANT_WEATHER_ALERT_RETENTION_DAYS=180
ASSISTANT_WEATHER_ALERT_TIMEOUT_SECONDS=12
ASSISTANT_WEATHER_ALERT_RETRY_MAX=3
ASSISTANT_WEATHER_ALERT_FAILURE_THRESHOLD=3
ASSISTANT_WEATHER_ALERT_FAILURE_PAUSE_MINUTES=60

# 和风天气备用源；旧版 Key 或新版 JWT 至少配置一种。
ASSISTANT_QWEATHER_API_KEY=
ASSISTANT_QWEATHER_TOKEN=
ASSISTANT_QWEATHER_API_HOST=https://api.qweather.com
ASSISTANT_QWEATHER_LOCATION_ID=
# ASSISTANT_QWEATHER_LATITUDE=31.23
# ASSISTANT_QWEATHER_LONGITUDE=121.47

# V2 Phase 2：企业微信智能机器人（群聊 @ 提问与 LLM 回复）。
ASSISTANT_WECOM_AI_ENABLED=false
ASSISTANT_WECOM_AI_MODE=long_connection
ASSISTANT_WECOM_AI_BOT_ID=
ASSISTANT_WECOM_AI_BOT_SECRET=
ASSISTANT_WECOM_AI_BOT_NAME=雪球日报助手
# 群聊/用户白名单；联调阶段可留空，之后从回调日志填入 chatid/userid。
ASSISTANT_WECOM_AI_ALLOWED_CHAT_IDS=[]
ASSISTANT_WECOM_AI_ALLOWED_USER_IDS=[]
ASSISTANT_WECOM_AI_WS_URL=wss://openws.work.weixin.qq.com
# 回调模式专用（当前使用长连接，无需填写）。
# ASSISTANT_WECOM_AI_CALLBACK_URL=
# ASSISTANT_WECOM_AI_TOKEN=
# ASSISTANT_WECOM_AI_ENCODING_AES_KEY=
ASSISTANT_TREND_RETENTION_DAYS=180
ASSISTANT_NEWS_TREND_MIN_COUNT=1
