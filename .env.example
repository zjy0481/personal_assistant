# V1 环境变量模板；复制为 .env 后按需修改。真实密钥不要提交到 Git。
ASSISTANT_LOCATION=上海
ASSISTANT_TIMEZONE=Asia/Shanghai
ASSISTANT_DATA_SOURCE_WHITELIST=["weather", "news", "github", "ai"]
ASSISTANT_SOURCE_WHITELIST=["xinhua", "people", "thepaper", "chinanews", "cctv", "reuters", "ap", "bbc"]

# 推送渠道按顺序尝试：pushplus 为主渠道，wecom_group 为备用渠道。
ASSISTANT_PUSH_CHANNELS=["pushplus", "wecom_group"]

# PushPlus 微信服务号主渠道；需在 PushPlus 完成微信实名认证后获取 token。
ASSISTANT_PUSHPLUS_TOKEN=

# 企业微信群机器人备用渠道；填写完整 Webhook URL，勿提交到 Git。
ASSISTANT_WECOM_GROUP_WEBHOOK=

# 每个内容板块默认推送条数上限。
ASSISTANT_PUSH_MAX_ITEMS=5

# 以下为企业微信自建应用遗留配置，仅供旧 WeComPushAdapter 使用；新方案不需要。
ASSISTANT_WECOM_CORPID=
ASSISTANT_WECOM_AGENTID=
ASSISTANT_WECOM_SECRET=
ASSISTANT_WECOM_USERID=
ASSISTANT_WECOM_MOCK=false

# 日报网页跳转地址；公网部署时改为实际可访问地址。
ASSISTANT_WEB_URL=http://127.0.0.1:8000/

# 公网网页鉴权 token；本机测试留空。
ASSISTANT_AUTH_TOKEN=
ASSISTANT_WEB_REQUIRE_AUTH=false